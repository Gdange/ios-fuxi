--- a/bsd/dev/fuxi_touch.c
+++ b/bsd/dev/fuxi_touch.c
@@ -0,0 +1,361 @@
+/*
+ * FUXI touch: ST FTS (FTM5) on QUP1 SE4, polled FIFO-mode SPI.
+ * Hardware facts and protocol: research/touch/hw-report.md; first proven in
+ * the loader (shim/fuxi-probe/probe.c request 0x55). The loader votes the
+ * RPMh rails (ldob12 vdd 1.8 V, ldom6 avdd 3.2 V) before the XNU handoff;
+ * this driver does not talk to RPMh. It takes the IC through its reset,
+ * waits for the controller-ready event, enables multi-touch scanning and
+ * polls the event FIFO while GPIO25 (IRQ, active low) is asserted.
+ * No firmware upload: the FTS keeps its firmware in its own flash.
+ */
+#if defined(FUXI)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+extern kern_return_t thread_terminate(thread_t);
+extern void sweet_hid_touch(int finger, int down, int x, int y);
+void fuxi_touch_init(void);
+
+#define FT_SE_PA     0x00a90000u
+#define FT_GCC_PA    0x00100000u
+#define FT_TLMM_PA   0x0f100000u   /* upstream tlmm@f100000; 0x0f0xxxxx aborts */
+#define FT_GPIO(n)   ((uint32_t)(n) * 0x1000u)
+#define FT_RESET     24u
+#define FT_IRQ       25u
+#define FT_MAX       10u
+#define FT_EV_READY  0x03u
+#define FT_EV_ENTER  0x13u
+#define FT_EV_MOTION 0x23u
+#define FT_EV_LEAVE  0x33u
+
+static struct {
+	vm_offset_t se, gcc, tlmm;
+	unsigned depth;
+	bool started;
+	uint32_t active;
+	int x[FT_MAX], y[FT_MAX];
+} ft;
+static int ft_chan;
+
+static uint32_t
+ft_rd(vm_offset_t base, uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(base + off);
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return v;
+}
+
+static void
+ft_wr(vm_offset_t base, uint32_t off, uint32_t v)
+{
+	__asm__ volatile("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(base + off) = v;
+	__asm__ volatile("dsb osh" ::: "memory");
+}
+
+static void
+ft_sleep(unsigned ms)
+{
+	uint64_t deadline;
+	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+	(void)assert_wait_deadline(&ft_chan, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+/* TLMM CTL: pull [1:0] (1 down, 3 up), func [5:2], drive [8:6] = mA/2-1, OE [9]. */
+static void
+ft_gpio(unsigned n, unsigned func, unsigned pull, unsigned ma, int out)
+{
+	if (out >= 0) {
+		ft_wr(ft.tlmm, FT_GPIO(n) + 4, out ? 2u : 0u);
+	}
+	ft_wr(ft.tlmm, FT_GPIO(n), (ft_rd(ft.tlmm, FT_GPIO(n)) & ~0x3ffu) | pull |
+	    (func << 2) | ((ma / 2 - 1) << 6) | (out >= 0 ? 0x200u : 0u));
+}
+
+static bool
+ft_clocks_on(void)
+{
+	return !(ft_rd(ft.gcc, 0x184e4) & 0x80000000u);
+}
+
+static int
+ft_clock(void)
+{
+	/* Vote wrapper1 core/core2x/m_ahb/s_ahb and SE4 only. */
+	ft_wr(ft.gcc, 0x52008, ft_rd(ft.gcc, 0x52008) | (0xfu << 18) | (1u << 26));
+	for (unsigned i = 0; i < 10000 && !ft_clocks_on(); i++) {
+		delay(1);
+	}
+	if (!ft_clocks_on()) {
+		printf("FUXI TOUCH: SE4 clock off (vote %#x cbcr %#x)\n",
+		    ft_rd(ft.gcc, 0x52008), ft_rd(ft.gcc, 0x184e4));
+		return EIO;
+	}
+	/* DFS level from XO, undivided (19.2 MHz); SE divider 2: 9.6 MHz SCLK. */
+	if (ft_rd(ft.gcc, 0x18504) & 1u) {
+		for (unsigned l = 0; l < 8; l++) {
+			if ((ft_rd(ft.gcc, 0x1850c + 4 * l) & 0x71fu) <= 1u) {
+				ft_wr(ft.se, 0x07c, l);
+				ft_wr(ft.se, 0x048, (2u << 4) | 1u);
+				return 0;
+			}
+		}
+		printf("FUXI TOUCH: no XO DFS level\n");
+		return EIO;
+	}
+	ft_wr(ft.se, 0x07c, 0);
+	ft_wr(ft.se, 0x048, (2u << 4) | 1u);
+	return 0;
+}
+
+static int
+ft_se_init(void)
+{
+	uint32_t fw = ft_rd(ft.se, 0x068), hw = ft_rd(ft.se, 0xe24);
+	if (((fw >> 8) & 0xff) != 1 || (ft_rd(ft.se, 0x064) & 1) || (ft_rd(ft.se, 0x040) & 1)) {
+		printf("FUXI TOUCH: SE4 fw %#x if %#x status %#x: not idle FIFO SPI\n",
+		    fw, ft_rd(ft.se, 0x064), ft_rd(ft.se, 0x040));
+		return ENODEV;
+	}
+	ft.depth = (hw >> 16) & 0x3f;
+	if (ft.depth < 4 || ((hw >> 24) & 0x3f) != 32) {
+		return ENODEV;
+	}
+	ft_wr(ft.se, 0xe18, 0);
+	ft_wr(ft.se, 0xe1c, 0);
+	ft_wr(ft.se, 0x618, 0xffffffffu);
+	ft_wr(ft.se, 0x648, 0xffffffffu);
+	ft_wr(ft.se, 0x028, ft_rd(ft.se, 0x028) | 0x7f);
+	ft_wr(ft.se, 0xe30, ft_rd(ft.se, 0xe30) | 0xf);
+	ft_wr(ft.se, 0x024, 0x7f);
+	ft_wr(ft.se, 0x020, 1);
+	ft_wr(ft.se, 0x258, 0);
+	ft_wr(ft.se, 0x810, ft.depth - 3);
+	ft_wr(ft.se, 0x814, ft.depth - 2);
+	ft_wr(ft.se, 0x80c, 0);
+	/* 8 bits per word, 4 per FIFO word, MSB first. */
+	ft_wr(ft.se, 0x260, 0x0007f8feu);
+	ft_wr(ft.se, 0x264, 0x000ffefeu);
+	ft_wr(ft.se, 0x284, 0x0007f8feu);
+	ft_wr(ft.se, 0x288, 0x000ffefeu);
+	ft_wr(ft.se, 0x254, 0);
+	ft_wr(ft.se, 0x268, 4);
+	ft_wr(ft.se, 0x224, 0);
+	ft_wr(ft.se, 0x22c, 0);
+	ft_wr(ft.se, 0x230, 0);
+	ft_wr(ft.se, 0x24c, 0);
+	ft_wr(ft.se, 0x250, 0);
+	ft_wr(ft.se, 0x25c, ft_rd(ft.se, 0x25c) & ~3u);
+	ft_wr(ft.se, 0x614, 0xffffffffu);
+	return 0;
+}
+
+/* One full-duplex FIFO command (CS held throughout); keeps len RX bytes. */
+static int
+ft_xfer(const uint8_t *tx, unsigned nt, uint8_t *rx, unsigned len)
+{
+	if (ft_rd(ft.se, 0x040) & 1) {
+		return EBUSY;
+	}
+	ft_wr(ft.se, 0x618, 0xffffffffu);
+	ft_wr(ft.se, 0x26c, len);
+	ft_wr(ft.se, 0x270, len);
+	ft_wr(ft.se, 0x600, 3u << 27);
+	unsigned sent = 0, got = 0;
+	for (unsigned us = 0; us < 20000; us++) {
+		while (sent < len && (ft_rd(ft.se, 0x800) & 0xfffffffu) + 1 < ft.depth) {
+			uint32_t w = 0;
+			for (unsigned j = 0; j < 4 && sent < len; j++, sent++) {
+				w |= (uint32_t)(sent < nt ? tx[sent] : 0) << (8 * j);
+			}
+			ft_wr(ft.se, 0x700, w);
+		}
+		uint32_t cnt = ft_rd(ft.se, 0x804) & 0x1ffffffu;
+		while (cnt--) {
+			uint32_t w = ft_rd(ft.se, 0x780);
+			for (unsigned j = 0; j < 4 && got < len; j++) {
+				rx[got++] = (uint8_t)(w >> (8 * j));
+			}
+		}
+		uint32_t irq = ft_rd(ft.se, 0x610);
+		if ((irq & 1) && got >= len && !(ft_rd(ft.se, 0x804) & 0x1ffffffu)) {
+			ft_wr(ft.se, 0x618, irq);
+			return 0;
+		}
+		if (irq & 0x3eu) {
+			break;
+		}
+		delay(1);
+	}
+	ft_wr(ft.se, 0x604, 2);
+	for (unsigned i = 0; i < 5000 && !(ft_rd(ft.se, 0x610) & (1u << 5)); i++) {
+		delay(1);
+	}
+	for (unsigned i = 0; i < 64 && (ft_rd(ft.se, 0x804) & 0x1ffffffu); i++) {
+		(void)ft_rd(ft.se, 0x780);
+	}
+	ft_wr(ft.se, 0x618, 0xffffffffu);
+	return EIO;
+}
+
+/* FTS read: opcode + address, one dummy byte, then n data bytes. */
+static int
+ft_read(const uint8_t *cmd, unsigned nc, uint8_t *out, unsigned n)
+{
+	uint8_t buf[8 + 1 + 8 * 32];
+	if (nc > 8 || n > 8 * 32) {
+		return EINVAL;
+	}
+	int e = ft_xfer(cmd, nc, buf, nc + 1 + n);
+	if (!e) {
+		memcpy(out, buf + nc + 1, n);
+	}
+	return e;
+}
+
+static void
+ft_report(uint32_t mask)
+{
+	for (unsigned id = 0; id < FT_MAX; id++) {
+		uint32_t bit = 1u << id;
+		if (mask & bit) {
+			sweet_hid_touch((int)id, 1, ft.x[id], ft.y[id]);
+		} else if (ft.active & bit) {
+			sweet_hid_touch((int)id, 0, ft.x[id], ft.y[id]);
+		}
+	}
+	ft.active = mask;
+}
+
+/* Drain the FIFO: one event, then the remaining count from byte 7. */
+static int
+ft_poll(void)
+{
+	static const uint8_t fifo[] = {0x87};
+	uint8_t e[8];
+	uint32_t mask = ft.active;
+	bool changed = false;
+	for (unsigned i = 0; i < 32; i++) {
+		int err = ft_read(fifo, 1, e, 8);
+		if (err) {
+			return err;
+		}
+		if (e[0] == 0) {
+			break;
+		}
+		unsigned id = e[1] >> 4;
+		if ((e[0] == FT_EV_ENTER || e[0] == FT_EV_MOTION || e[0] == FT_EV_LEAVE) && id < FT_MAX) {
+			/* Super-resolution coordinates, 10x the 1080x2400 panel. */
+			int x = ((e[3] << 8) | e[2]) / 10, y = ((e[5] << 8) | e[4]) / 10;
+			ft.x[id] = x > 1079 ? 1079 : x;
+			ft.y[id] = y > 2399 ? 2399 : y;
+			if (e[0] == FT_EV_LEAVE) {
+				mask &= ~(1u << id);
+			} else {
+				mask |= 1u << id;
+			}
+			changed = true;
+		}
+		if (!(e[7] & 0x1f)) {
+			break;
+		}
+	}
+	if (changed) {
+		ft_report(mask);
+	}
+	return 0;
+}
+
+static void
+ft_thread(void *arg, wait_result_t result)
+{
+	static const uint8_t id_cmd[] = {0xfb, 0x20, 0x00, 0x00, 0x00}, fifo[] = {0x87};
+	static const uint8_t sense[] = {0xa0, 0x00, 0x01};
+	uint8_t ev[8] = {0}, chip[2] = {0}, dummy[3];
+	unsigned delay_s = 30, errors = 0;
+	(void)arg;
+	(void)result;
+	(void)PE_parse_boot_argn("fuxitouchdelay", &delay_s, sizeof(delay_s));
+	printf("FUXI TOUCH: starting in %u s\n", delay_s);
+	ft_sleep(delay_s * 1000u);
+	ft.gcc = ml_io_map(FT_GCC_PA, 0x1f0000);
+	ft.tlmm = ml_io_map(FT_TLMM_PA, 0x30000);
+	ft.se = ml_io_map(FT_SE_PA, 0x4000);
+	if (!ft.gcc || !ft.tlmm || !ft.se || ft_clock() || ft_se_init()) {
+		goto out;
+	}
+	ft_gpio(FT_IRQ, 0, 3, 8, -1);
+	ft_gpio(44, 1, 1, 6, -1);
+	ft_gpio(45, 1, 1, 6, -1);
+	ft_gpio(46, 1, 1, 6, -1);
+	ft_gpio(47, 1, 3, 6, -1);
+	/* fts_system_reset: reset low 10 ms, high, then poll for controller ready. */
+	ft_gpio(FT_RESET, 0, 3, 8, 0);
+	ft_sleep(10);
+	ft_gpio(FT_RESET, 0, 3, 8, 1);
+	int err = EIO;
+	for (unsigned t = 0; t < 100; t++) {
+		ft_sleep(2);
+		if ((err = ft_read(fifo, 1, ev, 8)) || ev[0] == FT_EV_READY) {
+			break;
+		}
+	}
+	int cerr = ft_read(id_cmd, 5, chip, 2);
+	printf("FUXI TOUCH: reset err=%d event %02x %02x %02x %02x; chip id err=%d %02x%02x\n",
+	    err, ev[0], ev[1], ev[2], ev[3], cerr, chip[0], chip[1]);
+	if (err || cerr || ev[0] != FT_EV_READY) {
+		goto out;
+	}
+	if ((err = ft_xfer(sense, 3, dummy, 3))) {
+		printf("FUXI TOUCH: sense on failed %d\n", err);
+		goto out;
+	}
+	printf("FUXI TOUCH: sensing, polling GPIO%u\n", FT_IRQ);
+	for (;;) {
+		/* IRQ is level low while the FIFO holds events; poll it every 8 ms. */
+		if (!(ft_rd(ft.tlmm, FT_GPIO(FT_IRQ) + 4) & 1u) || ft.active) {
+			if (ft_poll()) {
+				if ((errors++ % 100u) == 0) {
+					printf("FUXI TOUCH: FIFO read error\n");
+				}
+				if (errors >= 10) {
+					ft_report(0);
+				}
+			} else {
+				errors = 0;
+			}
+		}
+		ft_sleep(8);
+	}
+out:
+	printf("FUXI TOUCH: stopped\n");
+	(void)thread_terminate(current_thread());
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+void
+fuxi_touch_init(void)
+{
+	int enabled = 1;
+	thread_t thread;
+	if (ft.started) {
+		return;
+	}
+	ft.started = true;
+	(void)PE_parse_boot_argn("fuxitouch", &enabled, sizeof(enabled));
+	if (!enabled) {
+		return;
+	}
+	if (kernel_thread_start(ft_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
+#endif /* FUXI */
